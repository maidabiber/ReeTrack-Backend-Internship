# Copy this file to .env and adjust for your local environment.
# Loaded by ReeTrack.Api on startup (see Program.cs) and merged into
# IConfiguration; existing shell/environment variables always win.
#
# Also used by docker compose:
#   docker compose --env-file .env -f src/docker-compose.yml up -d

ASPNETCORE_ENVIRONMENT=Development

# Origin allowed by the CORS policy for browser requests from the frontend.
Frontend__Origin=http://localhost:5173

# PostgreSQL (docker-compose + local API).
POSTGRES_DB=reetrack
POSTGRES_USER=reetrack_user
POSTGRES_PASSWORD=reetrack_pass
POSTGRES_PORT=5432

# Connection string for the API when run on the host (localhost).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reetrack;Username=reetrack_user;Password=reetrack_pass

# Google OAuth credentials (used by GET /api/auth/google redirect flow).
Google__ClientId=
Google__ClientSecret=

# OAuth callback URL — must be registered as an Authorized redirect URI in Google Cloud Console.
# Use the same origin as the SPA so session cookies are same-site (Vite proxies /api in dev).
# Dev:  http://localhost:5173/api/auth/google/callback
# Prod: https://app.example.com/api/auth/google/callback
Google__RedirectUri=http://localhost:5173/api/auth/google/callback

# Google Calendar integration OAuth callback (separate from sign-in).
# Dev:  http://localhost:5173/api/integrations/calendar/google/callback
# Prod: https://app.example.com/api/integrations/calendar/google/callback
Google__CalendarRedirectUri=http://localhost:5173/api/integrations/calendar/google/callback

# Calendar sync settings (background worker + stale sync triggers).
CalendarSync__IntervalMinutes=15
CalendarSync__LookbackDays=30
CalendarSync__LookaheadDays=90

# Optional. When set, only this email may become the first admin on initial setup.
Google__AdminEmail=

# JWT settings for API access tokens issued after Google sign-in.
Jwt__Issuer=reetrack
Jwt__Audience=reetrack-api
Jwt__SigningKey=change-me-to-a-long-random-secret-at-least-32-characters
Jwt__ExpiryMinutes=1440

# SMTP email delivery for member invitations. Works with any SMTP provider;
# free-tier options: SMTP2GO (mail.smtp2go.com:587, 1000 emails/month) or
# Mailjet (in-v3.mailjet.com:587, 200 emails/day). The From address must be
# a verified sender in your provider account.
# Leave Email__SmtpHost empty to log invite links to the console instead of sending.
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__From=ReeTrack <your-verified-sender@example.com>

# Invitation settings.
Invitation__ExpiryDays=7

# Email domains allowed to be invited. Mirror the domain(s) your Google SSO
# accepts, otherwise invites succeed but the invitee can never sign in. Leave
# unset to allow any domain. Add more with __1, __2, ... (e.g. reeinvent.io).
Invitation__AllowedDomains__0=reeinvent.com
Invitation__AllowedDomains__1=etf.unsa.ba

# Application display name used in invite emails and sign-in preview.
App__Name=ReeTrack
