# Copy this file to .env and adjust for your local environment.
# Loaded by ReeTrack.Api on startup (see Program.cs) and merged into
# IConfiguration; existing shell/environment variables always win.
#
# Also used by docker compose:
#   docker compose --env-file .env -f src/docker-compose.yml up -d

ASPNETCORE_ENVIRONMENT=Development

# Origin allowed by the CORS policy for browser requests from the frontend.
Frontend__Origin=http://localhost:5173

# PostgreSQL (docker-compose + local API).
POSTGRES_DB=reetrack
POSTGRES_USER=reetrack_user
POSTGRES_PASSWORD=reetrack_pass
POSTGRES_PORT=5432

# Connection string for the API when run on the host (localhost).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reetrack;Username=reetrack_user;Password=reetrack_pass

# Google OAuth credentials (used once authentication is wired up).
Google__ClientId=
Google__ClientSecret=
