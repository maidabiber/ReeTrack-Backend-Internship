DUCKDNS_DOMAIN=${domain}
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL runs as the `db` container on this box (see docker-compose.yml). These POSTGRES_*
# values initialise that container; ConnectionStrings__Default points the API at it over the
# internal compose network (no SSL needed — traffic never leaves the box).
POSTGRES_USER=${db_username}
POSTGRES_PASSWORD=${db_password}
POSTGRES_DB=${db_name}
ConnectionStrings__Default=Host=db;Port=5432;Database=${db_name};Username=${db_username};Password=${db_password}

Frontend__Origin=https://${domain}

Google__ClientId=${google_client_id}
Google__ClientSecret=${google_client_secret}
Google__RedirectUri=https://${domain}/api/auth/google/callback
Google__CalendarRedirectUri=https://${domain}/api/integrations/calendar/google/callback
Google__AdminEmail=${google_admin_email}

Jwt__SigningKey=${jwt_signing_key}
Jwt__Issuer=reetrack
Jwt__Audience=reetrack-api
Jwt__ExpiryMinutes=1440

DataProtection__KeyRingPath=/keys

Jira__SiteUrl=${jira_site_url}
Jira__Email=${jira_email}
Jira__ApiToken=${jira_api_token}
Jira__WebhookSecret=${jira_webhook_secret}

Llm__ApiKey=${llm_api_key}
Slack__BotToken=${slack_bot_token}

Email__SmtpHost=${smtp_host}
Email__SmtpPort=${smtp_port}
Email__SmtpUsername=${smtp_username}
Email__SmtpPassword=${smtp_password}
Email__From=${smtp_from}

Invitation__AllowedDomains__0=${invitation_domain_0}
Invitation__AllowedDomains__1=${invitation_domain_1}

App__Name=ReeTrack
